# Copy this file to /root/.env.webui on the Pod.
# Replace every REPLACE_WITH_TUNNEL_UUID value before starting the tunnel.
# Never commit the real /root/.env.webui or tunnel credential JSON.

CF_TUNNEL_UUID=REPLACE_WITH_TUNNEL_UUID
CF_TUNNEL_NAME=webui
CF_HOSTNAME=webui.jhinforge.xyz
CF_LOCAL_PORT=8780

CF_CONFIG_DIR=/root/.cloudflared
CF_CONFIG_FILE=/root/.cloudflared/webui.yml
CF_CREDENTIAL_SOURCE=/root/REPLACE_WITH_TUNNEL_UUID.json

EVERSPARK_LOG_DIR=/root/everspark_logs
TUNNEL_LOG=/root/everspark_logs/webui-tunnel.log
CLOUDFLARED_LOG=/root/everspark_logs/webui-cloudflared.log
