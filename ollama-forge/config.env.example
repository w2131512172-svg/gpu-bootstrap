# ===== EverSpark Forge - Ollama Forge =====

OLLAMA_HOME=/root/.ollama
OLLAMA_PORT=11434

RCLONE_REMOTE=r2-assets:ollama-forge

# Logging uses the shared EverSpark settings from /root/.env.
# Optional per-service overrides:
# OLLAMA_LIFECYCLE_LOG=/root/everspark_logs/ollama.log
# OLLAMA_SERVICE_LOG=/root/everspark_logs/ollama-service.log
